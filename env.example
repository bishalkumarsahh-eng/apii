# Required for protected API endpoints
API_KEY=replace-with-a-long-random-secret

COOKIE_URL=
DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000
DOWNLOAD_WORKERS=10

# Download Performance
CONCURRENT_FRAGMENT_DOWNLOADS=256
HTTP_CHUNK_SIZE=209715200

# Network / Retry
SOCKET_TIMEOUT=15
RETRIES=10
FRAGMENT_RETRIES=10

YOUTUBE_PLAYER_CLIENTS=default,web_embedded
YOUTUBE_USE_COOKIES=false
DIRECT_URL_CACHE_TTL=900
