# Required for protected API endpoints
API_KEY=replace-with-a-long-random-secret

COOKIE_URL=
DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000
DOWNLOAD_WORKERS=10

# Download Performance
CONCURRENT_FRAGMENT_DOWNLOADS=256
HTTP_CHUNK_SIZE=209715200

# Network / Retry
SOCKET_TIMEOUT=15
RETRIES=10
FRAGMENT_RETRIES=10

YOUTUBE_PLAYER_CLIENTS=web_embedded
YOUTUBE_USE_COOKIES=false

# Performance defaults for Heroku Basic
CONCURRENT_FRAGMENT_DOWNLOADS=12
HTTP_CHUNK_SIZE=0
SOCKET_TIMEOUT=12
RETRIES=2
FRAGMENT_RETRIES=2
YOUTUBE_USE_COOKIES=false
