# Required for protected API endpoints
API_KEY=replace-with-a-long-random-secret

COOKIE_URL=
DOWNLOAD_DIR=downloads
CACHE_EXPIRE_HOURS=24
MAX_VIDEO_QUALITY=720
PORT=8000
DOWNLOAD_WORKERS=10

# Download Performance
CONCURRENT_FRAGMENT_DOWNLOADS=256
HTTP_CHUNK_SIZE=209715200

# Network / Retry
SOCKET_TIMEOUT=15
RETRIES=10
FRAGMENT_RETRIES=10


# ShrutiBots audio downloader (Priority 1)
SHRUTI_API_URL=https://api01.shrutibots.site
SHRUTI_API_KEY=your_shrutibots_api_key_here
